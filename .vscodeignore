# Exclude source files (compiled output in dist/ is what gets packaged)
src/**/*.ts
!src/webview/**

# Dev tooling
tsconfig.json
.eslintrc*
.prettierrc*
.editorconfig
.gitignore
.github/

# Node modules — sql.js is bundled into dist/sql-asm.js at build time.
# Ship 'ws' (zero-dependency, pure JS) since the chatroom hub/client require it at runtime.
node_modules/**
!node_modules/ws/**

# Test and CI artifacts
tests/**
docs/**
**/*.test.ts
**/*.spec.ts
coverage/
.nyc_output/

# Misc
*.vsix
**/*.map
improvement_*.md
skill_vault.md

**/__pycache__/**
resources/.chat_cids.json

# demo/screenshot harness (never ship)
dist/webview/_demo*
resources/screenshots/**
scripts/release-preview-server.js
scripts/capture-release-screenshots.py
scripts/poc-*.js
