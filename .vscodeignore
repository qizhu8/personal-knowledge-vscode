# Exclude source files (compiled output in dist/ is what gets packaged)
src/**/*.ts
!src/webview/**

# Dev tooling
tsconfig.json
.eslintrc*
.prettierrc*
.editorconfig
.gitignore
.github/

# Node modules — sql.js is bundled into dist/sql-asm.js at build time.
# Ship 'ws' (zero-dependency, pure JS) since the chatroom hub/client require it at runtime.
node_modules/**
!node_modules/ws/**

# Test and CI artifacts
**/*.test.ts
**/*.spec.ts
coverage/
.nyc_output/

# Misc
*.vsix
*.map
improvement_*.md

# Agent-side helper (lives in the repo for users to copy; not part of the extension bundle)
chat_server.py
**/__pycache__/**

# demo/screenshot harness (never ship)
dist/webview/_demo*
resources/screenshots/**
