{
  "schema": "pkm.workflow.canonical-order/v1",
  "arrays": {
    "/spec/nodes": { "order": "set", "sortKey": ["nodeId"] },
    "/spec/nodes/*/dependsOn": { "order": "set", "sortKey": ["from", "accept"] },
    "/spec/nodes/*/dependsOn/*/accept": { "order": "set", "sortKey": ["$value"] },
    "/spec/completion/requiredNodes": { "order": "set", "sortKey": ["$value"] }
  }
}