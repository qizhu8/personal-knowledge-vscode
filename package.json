{
  "name": "personal-knowledge",
  "displayName": "Personal Knowledge Manager",
  "description": "%extension.description%",
  "version": "2.5.1",
  "publisher": "Uone",
  "author": {
    "name": "Yu Wang"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/qizhu8/personal-knowledge-vscode"
  },
  "homepage": "https://github.com/qizhu8/personal-knowledge-vscode#readme",
  "bugs": {
    "url": "https://github.com/qizhu8/personal-knowledge-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "knowledge",
    "skills",
    "notes",
    "productivity",
    "personal",
    "mcp",
    "pkm"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:personalKnowledge"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "personalKnowledge.pkm",
        "label": "Personal Knowledge Manager"
      }
    ],
    "commands": [
      {
        "command": "personalKnowledge.open",
        "title": "%command.open%",
        "icon": "$(book)"
      },
      {
        "command": "personalKnowledge.addNote",
        "title": "%command.addNote%"
      },
      {
        "command": "personalKnowledge.saveSkill",
        "title": "%command.saveSkill%"
      },
      {
        "command": "personalKnowledge.setupMcp",
        "title": "%command.openConfig%"
      },
      {
        "command": "personalKnowledge.openChatroom",
        "title": "%command.openChatroom%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "personalKnowledge.openServers",
        "title": "%command.openServers%",
        "icon": "$(server-environment)"
      },
      {
        "command": "personalKnowledge.startServerItem",
        "title": "%command.startServer%",
        "icon": "$(play)"
      },
      {
        "command": "personalKnowledge.stopServerItem",
        "title": "%command.stopServer%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "personalKnowledge.restartServerItem",
        "title": "%command.restartServer%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "personalKnowledge.openHostedRoomItem",
        "title": "Open / Rehost Room",
        "icon": "$(debug-start)"
      },
      {
        "command": "personalKnowledge.renameHostedRoom",
        "title": "Rename Room…",
        "icon": "$(edit)"
      },
      {
        "command": "personalKnowledge.closeHostedRoom",
        "title": "Close Room",
        "icon": "$(close)"
      },
      {
        "command": "personalKnowledge.deleteHostedRoom",
        "title": "Delete Room Data…",
        "icon": "$(trash)"
      },
      {
        "command": "personalKnowledge.refreshTree",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "personalKnowledge.editMarkdownMetadata",
        "title": "Personal Knowledge Manager: Edit Markdown Metadata",
        "icon": "$(edit)"
      },
      {
        "command": "personalKnowledge.editMarkdownContent",
        "title": "Personal Knowledge Manager: Edit Content",
        "icon": "$(edit)"
      },
      {
        "command": "personalKnowledge.openSkill",
        "title": "Open Skill"
      },
      {
        "command": "personalKnowledge.openNote",
        "title": "Open Note"
      },
      {
        "command": "personalKnowledge.openPrompt",
        "title": "Open Prompt"
      },
      {
        "command": "personalKnowledge.openPackage",
        "title": "Open Package"
      },
      {
        "command": "personalKnowledge.openScript",
        "title": "Open Script"
      },
      {
        "command": "personalKnowledge.showLogs",
        "title": "%command.showLogs%"
      },
      {
        "command": "personalKnowledge.setAiKey",
        "title": "Personal Knowledge Manager: Set AI API Key"
      },
      {
        "command": "personalKnowledge.addSkillHere",
        "title": "New Skill Here",
        "icon": "$(add)"
      },
      {
        "command": "personalKnowledge.addNoteHere",
        "title": "New Note Here",
        "icon": "$(add)"
      },
      {
        "command": "personalKnowledge.addPaperHere",
        "title": "New Paper Here",
        "icon": "$(add)"
      },
      {
        "command": "personalKnowledge.addIdeaHere",
        "title": "New Idea Here",
        "icon": "$(lightbulb)"
      },
      {
        "command": "personalKnowledge.addPromptHere",
        "title": "New Prompt Here",
        "icon": "$(add)"
      },
      {
        "command": "personalKnowledge.addScriptHere",
        "title": "New Script Here",
        "icon": "$(add)"
      },
      {
        "command": "personalKnowledge.editSkill",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "personalKnowledge.editNote",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "personalKnowledge.editPaper",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "personalKnowledge.editScript",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "personalKnowledge.deleteScript",
        "title": "Delete",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "personalKnowledge.open",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "personalKnowledge.addNote",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "personalKnowledge.saveSkill",
          "when": "editorHasSelection",
          "group": "personalKnowledge"
        }
      ],
      "view/title": [
        {
          "command": "personalKnowledge.open",
          "when": "view == personalKnowledge.sidebarView",
          "group": "navigation"
        },
        {
          "command": "personalKnowledge.refreshTree",
          "when": "view == personalKnowledge.sidebarView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "personalKnowledge.startServerItem",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-server-stopped",
          "group": "1_server@1"
        },
        {
          "command": "personalKnowledge.stopServerItem",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-server-active",
          "group": "1_server@1"
        },
        {
          "command": "personalKnowledge.restartServerItem",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-server-active",
          "group": "1_server@2"
        },
        {
          "command": "personalKnowledge.openHostedRoomItem",
          "when": "view == personalKnowledge.sidebarView && viewItem =~ /pk-chat-hosted-room-(active|stored)/",
          "group": "1_room@0"
        },
        {
          "command": "personalKnowledge.renameHostedRoom",
          "when": "view == personalKnowledge.sidebarView && viewItem =~ /pk-chat-hosted-room-(active|stored)/",
          "group": "1_room@1"
        },
        {
          "command": "personalKnowledge.closeHostedRoom",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-chat-hosted-room-active",
          "group": "1_room@2"
        },
        {
          "command": "personalKnowledge.deleteHostedRoom",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-chat-hosted-room-stored",
          "group": "2_danger@1"
        },
        {
          "command": "personalKnowledge.addSkillHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-skills-container",
          "group": "inline"
        },
        {
          "command": "personalKnowledge.addNoteHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-notes-container",
          "group": "inline"
        },
        {
          "command": "personalKnowledge.addScriptHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-scripts-container",
          "group": "inline"
        },
        {
          "command": "personalKnowledge.addPaperHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-papers-container",
          "group": "1_new@1"
        },
        {
          "command": "personalKnowledge.addIdeaHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-papers-container",
          "group": "1_new@2"
        },
        {
          "command": "personalKnowledge.addPromptHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-prompts-container",
          "group": "1_new"
        },
        {
          "command": "personalKnowledge.addSkillHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-skills-container",
          "group": "1_new"
        },
        {
          "command": "personalKnowledge.addNoteHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-notes-container",
          "group": "1_new"
        },
        {
          "command": "personalKnowledge.addScriptHere",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-scripts-container",
          "group": "1_new"
        },
        {
          "command": "personalKnowledge.editSkill",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-skill-item",
          "group": "inline"
        },
        {
          "command": "personalKnowledge.editNote",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-note-item",
          "group": "inline"
        },
        {
          "command": "personalKnowledge.editPaper",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-paper-item",
          "group": "inline"
        },
        {
          "command": "personalKnowledge.editScript",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-script-item",
          "group": "inline"
        },
        {
          "command": "personalKnowledge.editSkill",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-skill-item",
          "group": "1_edit"
        },
        {
          "command": "personalKnowledge.editNote",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-note-item",
          "group": "1_edit"
        },
        {
          "command": "personalKnowledge.editPaper",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-paper-item",
          "group": "1_edit"
        },
        {
          "command": "personalKnowledge.editScript",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-script-item",
          "group": "1_edit"
        },
        {
          "command": "personalKnowledge.deleteScript",
          "when": "view == personalKnowledge.sidebarView && viewItem == pk-script-item",
          "group": "1_edit"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "personalKnowledgeBar",
          "title": "Personal Knowledge Manager",
          "icon": "resources/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "personalKnowledgeBar": [
        {
          "id": "personalKnowledge.sidebarView",
          "name": "%view.knowledge%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "personalKnowledge.sidebarView",
        "contents": "Your personal knowledge base.\n\n[Open PKM Panel](command:personalKnowledge.open)\n\nShortcut: `Ctrl+Shift+K`"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "personalKnowledge.storePath": {
          "type": "string",
          "default": "",
          "description": "Custom path for the knowledge store directory. Defaults to ~/personal-knowledge if left empty."
        },
        "personalKnowledge.environmentsPath": {
          "type": "string",
          "default": "",
          "description": "Central location where the 'Migrate' action moves Python environments. Defaults to ~/pkm-envs if left empty."
        },
        "personalKnowledge.mcpPythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute Python 3.10+ executable used to create and run the managed PKM MCP environment. Machine-specific; not synced to remote hosts."
        },
        "personalKnowledge.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the Personal Knowledge Manager panel on VS Code startup."
        },
        "personalKnowledge.uiLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn",
            "es"
          ],
          "enumDescriptions": [
            "Follow the VS Code display language.",
            "English",
            "简体中文",
            "Español"
          ],
          "default": "auto",
          "description": "%configuration.uiLanguage%"
        },
        "personalKnowledge.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging verbosity. Use 'debug' to record all activity (including page views and messages) to the Output panel and log file; 'info' logs user actions only."
        },
        "personalKnowledge.maxTreeDepth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum number of folder levels shown in the sidebar tree for skills and notes. Deeper path segments collapse into the leaf item."
        },
        "personalKnowledge.aiBackend": {
          "type": "string",
          "enum": [
            "copilot",
            "azure-openai",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Use GitHub Copilot via the built-in VS Code Language Model API (no API key needed).",
            "Use Azure OpenAI. Set aiEndpoint, aiModel (deployment name), aiAzureApiVersion, and run 'Personal Knowledge Manager: Set AI API Key'.",
            "Use any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, etc.). Set aiEndpoint, aiModel, and run 'Personal Knowledge Manager: Set AI API Key'."
          ],
          "default": "copilot",
          "description": "Which AI backend to use for script summarization."
        },
        "personalKnowledge.aiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name (openai-compatible) or deployment name (azure-openai). Ignored for Copilot."
        },
        "personalKnowledge.aiEndpoint": {
          "type": "string",
          "default": "",
          "description": "Base URL for azure-openai (e.g. https://myres.openai.azure.com) or openai-compatible (e.g. https://api.openai.com/v1). Ignored for Copilot."
        },
        "personalKnowledge.aiAzureApiVersion": {
          "type": "string",
          "default": "2024-06-01",
          "description": "Azure OpenAI API version (azure-openai backend only)."
        },
        "personalKnowledge.chatHubUrl": {
          "type": "string",
          "default": "",
          "description": "Chatroom: WebSocket URL of the hub to connect to (e.g. ws://host:7345). Leave empty if you host the hub yourself."
        },
        "personalKnowledge.chatRoom": {
          "type": "string",
          "default": "general",
          "description": "Chatroom: default room name to join."
        },
        "personalKnowledge.chatDisplayName": {
          "type": "string",
          "default": "",
          "description": "Chatroom: display name shown to other members. Defaults to your OS username."
        },
        "personalKnowledge.chatSharedSecret": {
          "type": "string",
          "default": "",
          "description": "Chatroom: team shared secret used to join a room. Must match the hub's secret. Corpnet/VPN only for the MVP."
        },
        "personalKnowledge.chatHubPort": {
          "type": "number",
          "default": 7345,
          "description": "Chatroom: TCP port the embedded hub listens on when you self-host it."
        },
        "personalKnowledge.chatHistoryLimitMB": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Chatroom: how much chat history (in MB) the hub archives to disk per room, so messages survive rejoining, closing a room, or restarting the hub. The oldest messages are dropped once the limit is reached. Set to 0 to disable archiving."
        },
        "personalKnowledge.serversProxyPort": {
          "type": "number",
          "default": 39501,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "machine",
          "description": "Machine-local port for stable managed-server URLs under /s/<slug>/. The proxy runs in the VS Code extension host."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/webview dist/ && node scripts/build-panel.js && cp node_modules/sql.js/dist/sql-wasm.js dist/ && cp node_modules/sql.js/dist/sql-wasm.wasm dist/ && cp node_modules/marked/lib/marked.umd.js dist/webview/ && npx esbuild src/live-markdown-entry.js --bundle --platform=node --format=cjs --outfile=dist/live-markdown.js && npx esbuild src/webview/hljs-entry.js --bundle --minify --format=iife --outfile=dist/webview/hljs.js && cp node_modules/highlight.js/styles/github-dark.css dist/webview/hljs.css && cp node_modules/katex/dist/katex.min.js dist/webview/katex.js && cp node_modules/katex/dist/katex.min.css dist/webview/katex.css && mkdir -p dist/webview/fonts && cp node_modules/katex/dist/fonts/*.woff2 dist/webview/fonts/ && cp node_modules/cytoscape/dist/cytoscape.min.js dist/webview/cytoscape.js && cp node_modules/mermaid/dist/mermaid.min.js dist/webview/mermaid.js && cp node_modules/3d-force-graph/dist/3d-force-graph.min.js dist/webview/forcegraph3d.js && node scripts/postbuild.js",
    "screenshots": "python scripts/capture-release-screenshots.py",
    "screenshots:gif": "python scripts/capture-release-screenshots.py --gif",
    "test:chat-persistence": "npm run build && node tests/test-chat-persistence.js",
    "test:chat-stored-rooms": "npm run build && node tests/test-chat-stored-rooms.js",
    "test:chat-stored-rooms-ui": "npm run build && node tests/test-chat-stored-rooms-ui.js",
    "test:chat-participant-persistence": "npm run build && node tests/test-chat-participant-persistence.js",
    "test:chat-join-approval": "npm run build && node tests/test-chat-join-approval.js",
    "test:chat-hub-approval": "npm run build && node tests/test-chat-hub-approval.js",
    "test:chat-join-approval-ui": "npm run build && node tests/test-chat-join-approval-ui.js",
    "test:chat-moderation-ui": "npm run build && node tests/test-chat-moderation-ui.js",
    "test:chat-mention-highlight-ui": "npm run build && node tests/test-chat-mention-highlight-ui.js",
    "test:chat-room-identity": "npm run build && node tests/test-chat-room-identity.js",
    "test:chat-default-recipient-ui": "npm run build && node tests/test-chat-default-recipient-ui.js",
    "test:chat-multi-recipient": "npm run build && node tests/test-chat-multi-recipient.js",
    "test:chat-magic-link": "npm run build && node tests/test-chat-magic-link.js",
    "test:chat-mcp-approval": "npm run build && node tests/test-chat-mcp-approval.js",
    "test:chat-packaged-worker": "npm run build && node tests/test-chat-packaged-worker.js",
    "test:chat-hub-health": "npm run build && node tests/test-chat-hub-health.js",
    "test:chat-history-atomic": "python tests/test-chat-history-atomic.py",
    "test:chat-generated-standby": "python tests/test-chat-generated-standby.py",
    "test:chat-markdown": "npm run build && node tests/test-chat-markdown.js",
    "test:chat-quote-viewer-ui": "npm run build && node tests/test-chat-quote-viewer-ui.js",
    "test:mcp-version-ui": "npm run build && node tests/test-mcp-version-ui.js",
    "test:chat-layout-scroll-ui": "npm run build && node tests/test-chat-layout-scroll-ui.js",
    "test:pkm-skill-projection": "npm run build && node tests/test-pkm-skill-projection.js",
    "test:pkm-skill-mcp": "node tests/test-pkm-skill-mcp.js",
    "test:server-proxy": "npm run build && node tests/test-server-proxy.js",
    "test:navigation-status": "npm run build && node tests/test-navigation-status.js",
    "test:localization": "npm run build && node tests/test-localization.js",
    "test:release": "npm run build && node tests/test-chat-persistence.js && node tests/test-chat-stored-rooms.js && node tests/test-chat-stored-rooms-ui.js && node tests/test-chat-participant-persistence.js && node tests/test-chat-join-approval.js && node tests/test-chat-hub-approval.js && node tests/test-chat-join-approval-ui.js && node tests/test-chat-moderation-ui.js && node tests/test-chat-mention-highlight-ui.js && node tests/test-chat-room-identity.js && node tests/test-chat-default-recipient-ui.js && node tests/test-chat-multi-recipient.js && node tests/test-chat-magic-link.js && node tests/test-chat-mcp-approval.js && node tests/test-chat-packaged-worker.js && node tests/test-chat-hub-health.js && python tests/test-chat-history-atomic.py && python tests/test-chat-generated-standby.py && node tests/test-chat-markdown.js && node tests/test-chat-quote-viewer-ui.js && node tests/test-mcp-version-ui.js && node tests/test-chat-layout-scroll-ui.js && node tests/test-pkm-skill-projection.js && node tests/test-pkm-skill-mcp.js && node tests/test-server-proxy.js && node tests/test-navigation-status.js && node tests/test-localization.js",
    "poc:chat-room-lifecycle": "npm run build && node scripts/poc-chat-room-lifecycle.js",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "npx vsce package"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "cytoscape": "^3.34.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "sql.js": "^1.12.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
