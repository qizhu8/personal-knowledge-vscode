{
  "name": "@pkm/next-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:compat": "npm --prefix legacy run build",
    "typecheck:client": "tsc -p clients/vscode/tsconfig.json",
    "test:smoke": "node --experimental-transform-types --test --test-concurrency=2 tests/markdown.test.mjs tests/linux-root-writer-fence.test.mjs tests/client-manager-workflow.test.mjs",
    "test": "node scripts/verify.mjs",
    "progress": "node scripts/migration.mjs progress",
    "migration:inventory": "node scripts/migration.mjs inventory"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "casbin": "5.51.1",
    "image-size": "2.0.4",
    "ipaddr.js": "2.5.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "casbin": {
      "csv-parse": "7.0.2",
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/vscode": "1.90.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
